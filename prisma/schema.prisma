datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id
  email     String   @unique
  role      String
  createdAt DateTime @default(now())
}

model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String
  priority    String
  status      String   @default("open")
  submittedBy String
  submittedAt DateTime @default(now())
}
